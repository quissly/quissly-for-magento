<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- A refused catalog sync is otherwise silent: shoppers keep getting
         native search, so the only trace is a health record on a dashboard
         nobody has a reason to open. This puts it in front of the merchant. -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="quisslySyncRejected" xsi:type="string">
                    Quissly\Search\Model\AdminNotification\SyncRejectedMessage
                </item>
            </argument>
        </arguments>
    </type>
</config>
