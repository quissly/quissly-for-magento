/** @var \Quissly\Search\ViewModel\VoiceConfig $voiceConfig */
$voiceConfig = $block->getData('voice_config');
?>
<?php if ($voiceConfig && $voiceConfig->shouldRender()): ?>
<div data-quissly-voice-endpoint="<?= $escaper->escapeHtmlAttr($voiceConfig->endpoint()) ?>"
     data-label-start="<?= $escaper->escapeHtmlAttr(__('Search by voice')) ?>"
     data-label-listening="<?= $escaper->escapeHtmlAttr(__('Listening…')) ?>"
     data-label-searching="<?= $escaper->escapeHtmlAttr(__('Searching…')) ?>"
     data-label-denied="<?= $escaper->escapeHtmlAttr(__('Microphone unavailable.')) ?>"
     data-label-empty="<?= $escaper->escapeHtmlAttr(__('Nothing found - try again.')) ?>"
     data-label-unavailable="<?= $escaper->escapeHtmlAttr(__('Voice search is unavailable right now.')) ?>"
     style="display:none"></div>
<style>
    .quissly-voice-button {
        margin-left: 6px; border: none; background: transparent;
        font-size: 18px; cursor: pointer; vertical-align: middle;
    }
    .quissly-voice-button.recording { animation: quissly-pulse 1s infinite; }
    .quissly-voice-notice { margin-left: 6px; font-size: 12px; color: #666; }
    @keyframes quissly-pulse { 50% { opacity: 0.3; } }
</style>
<script src="<?= $escaper->escapeUrl($block->getViewFileUrl('Quissly_Search::js/quissly-voice.js')) ?>" defer></script>
<?php endif; ?>
