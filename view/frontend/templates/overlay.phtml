/** @var \Quissly\Search\ViewModel\OverlayConfig $overlayConfig */
$overlayConfig = $block->getData('overlay_config');
$overlayJs = $block->getViewFileUrl('Quissly_Search::js/quissly-overlay.js');
?>
<?php if ($overlayConfig && $overlayConfig->shouldRender()): ?>
<div data-quissly-overlay
     data-immersive="<?= $overlayConfig->isImmersive() ? '1' : '0' ?>"
     data-mount-selector="<?= $escaper->escapeHtmlAttr($overlayConfig->mountSelector()) ?>"
     data-results-url="<?= $escaper->escapeHtmlAttr($overlayConfig->resultsUrl()) ?>"
     data-label-title="<?= $escaper->escapeHtmlAttr(__('Search')) ?>"
     data-label-placeholder="<?= $escaper->escapeHtmlAttr(__('Search products…')) ?>"
     data-label-close="<?= $escaper->escapeHtmlAttr(__('Close')) ?>"
     data-suggestions="<?= $escaper->escapeHtmlAttr($overlayConfig->suggestionsJson()) ?>"
     style="display:none"></div>
<style>
    /* The bar sits at the top and spans the page; Quick's suggestions fill
       the space below it (.quissly-overlay__results). */
    .quissly-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: none; align-items: flex-start; justify-content: center;
        padding: 24px clamp(16px, 3vw, 48px);
        overflow-y: auto;
        background: rgba(20, 20, 25, 0.45);
        -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
        opacity: 0; transition: opacity .16s ease;
    }
    .quissly-overlay.is-open { display: flex; opacity: 1; }
    html.quissly-overlay-open { overflow: hidden; }
    .quissly-overlay__panel {
        width: 100%;
        display: flex; flex-direction: column; gap: 18px;
        transform: translateY(-8px) scale(.985);
        transition: transform .18s cubic-bezier(.2, .8, .3, 1);
    }
    .quissly-overlay.is-open .quissly-overlay__panel { transform: none; }
    .quissly-overlay__bar { display: flex; align-items: center; gap: 14px; }
    /* Above the bar's drop shadow, which would otherwise grey the card's top. */
    .quissly-overlay__results { position: relative; z-index: 1; }
    .quissly-overlay__results:empty { display: none; }
    .quissly-overlay .quissly-overlay__close {
        flex: 0 0 auto;
        display: flex; align-items: center; justify-content: center;
        width: 68px; height: 68px; padding: 0; margin: 0;
        background: #fff; color: #4b4b57;
        border: 0; border-radius: 50%;
        box-shadow: 0 20px 55px rgba(0, 0, 0, .3), 0 2px 8px rgba(0, 0, 0, .14);
        cursor: pointer;
        transition: transform .15s ease, color .15s ease;
    }
    .quissly-overlay .quissly-overlay__close svg {
        width: 22px; height: 22px; display: block;
        fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round;
    }
    .quissly-overlay .quissly-overlay__close:hover { background: #fff; color: #1d1d22; transform: translateY(-1px); }
    .quissly-overlay .quissly-overlay__close:focus-visible {
        outline: none;
        box-shadow: 0 20px 55px rgba(0, 0, 0, .3), 0 0 0 5px rgba(248, 246, 243, .6);
    }
    @media (max-width: 600px) {
        .quissly-overlay { padding: 12px; }
        .quissly-overlay__bar { gap: 8px; }
        .quissly-overlay .quissly-overlay__close { width: 56px; height: 56px; }
    }
    .quissly-overlay .quissly-overlay__field {
        flex: 1 1 auto; min-width: 0;
        position: relative;
        box-sizing: border-box;
        display: flex; align-items: center; gap: 14px;
        padding: 0 14px 0 26px;
        background: #fff;
        border: 0;
        border-radius: 999px;
        box-shadow: 0 20px 55px rgba(0, 0, 0, .3), 0 2px 8px rgba(0, 0, 0, .14);
        transition: box-shadow .18s ease, transform .18s ease;
    }
    .quissly-overlay .quissly-overlay__field:focus-within {
        transform: translateY(-1px);
        box-shadow: 0 26px 65px rgba(0, 0, 0, .36), 0 0 0 5px rgba(248, 246, 243, .6);
    }
    .quissly-overlay .quissly-overlay__icon {
        flex: 0 0 auto;
        width: 21px; height: 21px;
        fill: none; stroke: #9a9aa4; stroke-width: 2;
        stroke-linecap: round; stroke-linejoin: round;
        transition: stroke .18s ease;
    }
    .quissly-overlay .quissly-overlay__field:focus-within .quissly-overlay__icon {
        stroke: #4b4b57;
    }
    /* Merchant themes style bare inputs heavily (Luma adds a border, radius and
       height). Reset hard inside our namespace so the widget looks identical on
       Luma, Hyva and custom themes. */
    .quissly-overlay .quissly-overlay__input,
    .quissly-overlay .quissly-overlay__input:focus,
    .quissly-overlay .quissly-overlay__input:hover {
        -webkit-appearance: none !important;
        appearance: none !important;
        box-sizing: border-box !important;
        flex: 1 1 auto !important;
        width: 100% !important; min-width: 0 !important;
        height: auto !important; min-height: 0 !important;
        margin: 0 !important;
        padding: 21px 0 !important;
        background: transparent !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        outline: none !important;
        font-family: inherit !important;
        font-size: 20px !important;
        line-height: 1.3 !important;
        font-weight: 400 !important;
        color: #1d1d22 !important;
        letter-spacing: normal !important;
    }
    .quissly-overlay .quissly-overlay__input::placeholder {
        color: #a3a3ad !important; opacity: 1 !important;
    }
    /* Trigger - rendered ONLY on themes with no search input of their own.
       Two placements: inline beside a header control we can positively
       identify (cart, account, language switcher, or the merchant's own mount
       selector), otherwise floating bottom-left. Never injected blindly. */
    .quissly-overlay-trigger {
        display: inline-flex; align-items: center; justify-content: center;
        width: 44px; height: 44px; padding: 0;
        background: transparent; color: inherit;
        border: 0; border-radius: 50%;
        cursor: pointer; vertical-align: middle;
        transition: background .16s ease, transform .16s ease;
    }
    .quissly-overlay-trigger svg {
        width: 22px; height: 22px; display: block;
        fill: none; stroke: currentColor; stroke-width: 2;
        stroke-linecap: round; stroke-linejoin: round;
    }
    /* Author styles beat the UA sheet's [hidden] { display: none }, so the
       display: inline-flex above would otherwise keep a hidden fallback visible. */
    .quissly-overlay-trigger[hidden] { display: none; }
    .quissly-overlay-trigger:hover { background: rgba(0, 0, 0, .06); }
    .quissly-overlay-trigger:focus-visible {
        outline: none; box-shadow: 0 0 0 3px rgba(99, 102, 241, .35);
    }
    /* Inline: sits in the header row beside a control the theme already has,
       inheriting its icon colour. Layout-neutral on purpose: no float and no
       negative margins, so it behaves in flex, inline and float headers alike.
       Which SIDE of the anchor it lands on is decided by measuring, in JS. */
    .quissly-overlay-trigger--inline { margin: 0 6px; vertical-align: middle; }
    /* Floating: nothing in the header to anchor to. Bottom-LEFT, not top-right:
       top-right is where nearly every theme keeps its cart, and the chat bubble
       owns bottom-right. */
    .quissly-overlay-trigger--floating {
        position: fixed; bottom: 18px; left: 18px; z-index: 9998;
        width: 46px; height: 46px;
        background: #fff; color: #4b4b57;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .18), 0 1px 3px rgba(0, 0, 0, .1);
    }
    .quissly-overlay-trigger--floating:hover {
        background: #fff; transform: translateY(-1px);
        box-shadow: 0 8px 22px rgba(0, 0, 0, .24), 0 1px 3px rgba(0, 0, 0, .1);
    }
    @media (max-width: 480px) {
        .quissly-overlay-trigger { width: 40px; height: 40px; }
        /* Phone headers are tight; give back the breathing room. */
        .quissly-overlay-trigger--inline { margin: 0 2px; }
        .quissly-overlay-trigger--floating { bottom: 12px; left: 12px; }
    }
    .quissly-overlay__actions {
        display: flex; align-items: center; gap: 4px;
        flex: 0 0 auto;
    }
    .quissly-overlay__actions:not(:empty) {
        margin-left: 4px; padding-left: 12px;
        border-left: 1px solid #e8e8ee;
    }
    /* The voice/image widgets mount their own buttons here; restyle them to
       belong to the bar instead of the header they were designed for. */
    .quissly-overlay__actions .quissly-voice-button,
    .quissly-overlay__actions .quissly-image-button {
        display: flex; align-items: center; justify-content: center;
        width: 40px; height: 40px; padding: 0; margin: 0;
        background: transparent; border: 0; border-radius: 50%;
        color: #7a7a86; line-height: 1; cursor: pointer;
        transition: background .15s ease, color .15s ease;
    }
    .quissly-overlay__actions .quissly-voice-button svg,
    .quissly-overlay__actions .quissly-image-button svg {
        width: 20px; height: 20px; display: block;
    }
    .quissly-overlay__actions .quissly-voice-button:hover,
    .quissly-overlay__actions .quissly-image-button:hover {
        background: #f1f1f6; color: #4b4b57;
    }
    .quissly-overlay__actions .quissly-voice-button.recording {
        background: #fdecec; color: #d64545;
        animation: quissly-overlay-pulse 1.2s ease-in-out infinite;
    }
    @keyframes quissly-overlay-pulse {
        50% { background: #f9d5d5; }
    }
    /* Status text sits under the bar so it never resizes the capsule. */
    .quissly-overlay__actions .quissly-voice-notice,
    .quissly-overlay__actions .quissly-image-notice {
        position: absolute; left: 0; top: 100%;
        margin-top: 12px; width: 100%;
        text-align: center; font-size: 13px;
        color: rgba(255, 255, 255, .92);
        text-shadow: 0 1px 3px rgba(0, 0, 0, .55);
    }
    /* Phones: a slimmer bar, the same height as the close button beside it
       (after the input reset above, which it has to override). */
    @media (max-width: 600px) {
        .quissly-overlay .quissly-overlay__field { padding: 0 8px 0 18px; gap: 10px; }
        .quissly-overlay .quissly-overlay__input,
        .quissly-overlay .quissly-overlay__input:focus,
        .quissly-overlay .quissly-overlay__input:hover {
            padding: 15px 0 !important; font-size: 17px !important;
        }
    }
    .quissly-overlay .quissly-overlay__input::-webkit-search-cancel-button,
    .quissly-overlay .quissly-overlay__input::-webkit-search-decoration {
        -webkit-appearance: none; display: none;
    }
</style>
<script src="<?= $escaper->escapeUrl($overlayJs) ?>" defer></script>
<?php endif; ?>
