<?xml version="1.0"?>
<!--
/**
 * Copyright © Quissly. All rights reserved.
 * See COPYING.txt for license details.
 *
 * The only VISIBLE thing this module adds to a results page, and it renders
 * nothing unless the URL carries ?quissly_debug=1. No template is overridden and
 * no existing block is moved or restyled - a shopper's results page is what the
 * theme produced, plus (shopping activity switch on) one hidden element and a
 * script at the end of the body that report the search to Quissly's analytics.
 *
 * after="-" is load-bearing, not cosmetic: the search runs when the product
 * list block loads its collection, so a block placed BEFORE it renders while
 * the signal is still empty and reports nothing at all.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block name="quissly.search.origin"
                   class="Magento\Framework\View\Element\Template"
                   template="Quissly_Search::search-origin.phtml"
                   after="-">
                <arguments>
                    <argument name="search_origin" xsi:type="object">Quissly\Search\ViewModel\SearchOrigin</argument>
                </arguments>
            </block>
        </referenceContainer>
        <!-- Shopping activity: this search, for Quissly's analytics (renders nothing while
             the switch is off). Markup-free: a hidden host element and a script. -->
        <referenceContainer name="before.body.end">
            <block name="quissly.events.search" template="Quissly_Search::events.phtml">
                <arguments>
                    <argument name="events_config" xsi:type="object">Quissly\Search\ViewModel\EventsConfig</argument>
                    <argument name="page" xsi:type="string">search</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
