<?php
// A first sync takes minutes. Reporting it only as often as the merchant
// presses reload makes a working sync look frozen, and the commonest reaction
// to that is to press "Start full sync" again.
//
// Polls a read-only JSON endpoint until nothing is running, then reloads once
// so the whole page (gate state, unlocked toggles, banners) is consistent
// rather than half-updated by JavaScript.
?>
<script>
(function () {
    'use strict';

    var url = '<?= $escaper->escapeJs($block->getUrl('quissly/dashboard/progress')) ?>';
    var INTERVAL_MS = 25000;
    var MAX_TICKS = 72;          // ~30 minutes, so an abandoned tab stops polling
    var timer = null;
    var ticks = 0;
    // Only a run we WATCHED finish is worth reloading for. Reloading because
    // nothing is running would loop forever on a store whose gate is closed
    // and whose sync has not been started yet.
    var sawRunning = false;

    function line(el, p) {
        var txt = '';

        // Mirrors what the server rendered into this element, so a poll never
        // rewrites a store that has run no full sync into "0 of 0 sent".
        if (p.total) {
            txt = 'Progress: ' + (p.ok || 0) + ' of ' + p.total + ' sent, ' + (p.failed || 0) + ' failed.';
        }
        if (p.running) {
            txt += (txt ? ' ' : '') + 'Running now.';
            if (p.pending) {
                txt += ' ' + p.pending + ' still queued.';
            }
        } else if (p.last_run) {
            var at = p.last_run.at ? new Date(p.last_run.at * 1000).toLocaleString() : '';
            txt += (txt ? ' ' : '') + 'Last sync' + (at ? ' ' + at : '') + ': ' +
                (p.last_run.ok || 0) + ' sent, ' +
                (p.last_run.failed || 0) + ' failed, ' +
                (p.last_run.pending || 0) + ' still queued.';
        }
        if (p.stalled) {
            txt += (txt ? ' ' : '') + 'This sync stopped before it finished. Start it again to continue.';
        }
        el.textContent = txt;
    }

    function tick() {
        if (++ticks > MAX_TICKS) {
            window.clearInterval(timer);
            return;
        }
        fetch(url, {credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                if (!data || !data.sites) {
                    return;
                }
                var stillRunning = false;
                Object.keys(data.sites).forEach(function (id) {
                    var site = data.sites[id];
                    var el = document.querySelector('[data-quissly-progress="' + id + '"]');
                    if (el && site.progress) {
                        line(el, site.progress);
                    }
                    if (site.running) {
                        stillRunning = true;
                        sawRunning = true;
                    }
                });
                if (sawRunning && !stillRunning) {
                    // Finished while we were watching: reload so the gate, the
                    // feature toggles and any banner all agree with each other.
                    window.clearInterval(timer);
                    window.location.reload();
                }
            })
            .catch(function () { /* a dropped poll is not worth a message; the next one retries */ });
    }

    // Only poll when something is actually in flight.
    if (document.querySelector('[data-quissly-syncing="1"]')) {
        timer = window.setInterval(tick, INTERVAL_MS);
    }

    // Settling period after a connect: count the note down and unlock the
    // sync button when it reaches zero, so nobody has to reload to find out.
    document.querySelectorAll('[data-quissly-hold]').forEach(function (note) {
        var left = parseInt(note.getAttribute('data-quissly-hold'), 10);
        var number = note.querySelector('[data-quissly-hold-seconds]');
        var button = note.closest('form').querySelector('button[type="submit"]');
        var countdown = window.setInterval(function () {
            left -= 1;
            if (left <= 0) {
                window.clearInterval(countdown);
                note.parentNode.hidden = true;
                button.disabled = false;
                return;
            }
            number.textContent = String(left);
        }, 1000);
    });
})();
</script>
